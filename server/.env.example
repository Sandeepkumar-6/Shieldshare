# ShieldShare server configuration (docs/api/api-contract.md §7).
# Copy to server/.env and fill in. Never commit server/.env.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shieldshare

# At least 32 random characters, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token lifetime. There are no refresh tokens in the MVP, so this is also the session length.
JWT_ACCESS_TTL=15m

# Exact origin of the React client (CORS allows only this origin)
CLIENT_ORIGIN=http://localhost:5173

# Blob storage, outside any web root. Relative paths resolve from server/.
# Blobs are stored under random keys, never under the user's filename.
STORAGE_DIR=./storage
# 25 MB
MAX_UPLOAD_BYTES=26214400
# Longest allowed share-link lifetime, in days
SHARE_MAX_EXPIRY_DAYS=30
# Optional: requests per minute per client IP across /api (default 300)
# API_RATE_LIMIT_PER_MINUTE=300

# Phase 5 (ML service).
ML_SERVICE_URL=http://127.0.0.1:8000
ML_ENABLED=true

# Phase 5 (Shield AI). Keys stay server-side; never use a VITE_ prefix.
# AI_PROVIDER: gemini | openai. Each provider reads its own key (LLM_API_KEY is a fallback).
# Without a key Shield AI reports "unavailable" and everything else keeps working.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Default per provider: gemini-3.8-flash (gemini), gpt-5-mini (openai)
AI_MODEL=
# Whole investigation, all tool rounds together
AI_TIMEOUT_MS=60000
AI_MAX_TOOL_ROUNDS=6
# Includes the model's reasoning (thinking) tokens; too low a value cuts answers short
AI_MAX_OUTPUT_TOKENS=4096
AI_RATE_LIMIT_PER_MINUTE=20

# Phase 4 (controlled simulator, spec §30). Enabled only by the exact value "true"; the
# server refuses to start with it enabled when NODE_ENV=production.
SIMULATOR_ENABLED=false
# The one account the simulator acts as: a normal user created and flagged by `npm run seed`.
# Use a dedicated address: the simulator's reset deletes this account's files.
SIMULATOR_DEMO_USER_EMAIL=
SIMULATOR_DEMO_USER_PASSWORD=

# Seed script only. Creates the configured admin/user plus eight fictional @shieldshare.demo
# users with populated workspaces. All eight use SEED_USER_PASSWORD; no demo password is
# stored in source. Re-running the command is idempotent.
SEED_ADMIN_NAME=ShieldShare Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_NAME=Demo User
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
